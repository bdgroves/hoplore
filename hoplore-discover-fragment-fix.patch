From dcd14d8213bde53639b787d9f85df63adac979bc Mon Sep 17 00:00:00 2001
From: test <test@test.com>
Date: Mon, 14 Sep 2026 22:17:17 +0000
Subject: [PATCH] discover_varieties: strip URL fragments before matching

A same-page anchor (href="#", likely 'skip to content' or 'back to top')
resolves against BASE to '.../variety-data-sheets/#' via urljoin, which
passes the path-substring filter and yields a phantom variety named '#'.
Strip the fragment first, and reject any candidate name with no
alphanumeric character as a second line of defense.
---
 tools/ingest/hopsteiner.py | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/tools/ingest/hopsteiner.py b/tools/ingest/hopsteiner.py
index 2139180..0dea223 100644
--- a/tools/ingest/hopsteiner.py
+++ b/tools/ingest/hopsteiner.py
@@ -32,7 +32,7 @@ import sys
 import time
 from dataclasses import dataclass, field
 from pathlib import Path
-from urllib.parse import urljoin
+from urllib.parse import urljoin, urldefrag
 
 import requests
 from bs4 import BeautifulSoup
@@ -370,10 +370,14 @@ def discover_varieties(delay: float) -> dict[str, str]:
     varieties = {}
     for link in soup.find_all("a", href=True):
         href = urljoin(BASE, link["href"])
+        # Drop the fragment before matching. A same-page anchor like href="#"
+        # resolves against BASE to ".../variety-data-sheets/#" — it contains
+        # the path we're filtering for, but it is not a variety page.
+        href = urldefrag(href).url
         if "/variety-data-sheets/" not in href:
             continue
         name = href.rstrip("/").split("/")[-1]
-        if name in ("variety-data-sheets", "") or "?" in name:
+        if name in ("variety-data-sheets", "") or "?" in name or not re.search(r"[a-zA-Z0-9]", name):
             continue
         varieties[name] = link.get_text(strip=True) or name
 
